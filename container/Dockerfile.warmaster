# Warmaster Agent Container
# Extends base hydra-agent with offensive/admin tools for VM management and pentesting

FROM hydra-agent:latest

# Switch to root to install packages
USER root

# Install offensive/admin tools
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-venv \
    openssh-client \
    sshpass \
    nmap \
    netcat-openbsd \
    dnsutils \
    iputils-ping \
    binutils \
    && rm -rf /var/lib/apt/lists/*

# Install radare2 from official release
RUN curl -sL https://github.com/radareorg/radare2/releases/download/6.0.8/radare2_6.0.8_amd64.deb -o /tmp/radare2.deb \
    && dpkg -i /tmp/radare2.deb \
    && rm /tmp/radare2.deb

# Install Python packages for Windows remote management
RUN pip3 install --break-system-packages \
    pywinrm \
    requests \
    impacket \
    ldap3

# Install Responder (LLMNR/NBT-NS/mDNS poisoner and credential capture)
RUN git clone --depth 1 https://github.com/lgandx/Responder.git /opt/Responder
ENV PATH="/opt/Responder:$PATH"

# ============================================
# Ghidra Headless (Option 1 - Direct Install)
# Remove this section to switch to MCP-based Option 2
# Size impact: ~600MB
# ============================================

# Install Java 21 (required for Ghidra 12.x) via direct tarball
RUN apt-get update && apt-get install -y wget unzip \
    && rm -rf /var/lib/apt/lists/* \
    && wget -q https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.6%2B7/OpenJDK21U-jdk_x64_linux_hotspot_21.0.6_7.tar.gz -O /tmp/jdk.tar.gz \
    && mkdir -p /opt/java \
    && tar -xzf /tmp/jdk.tar.gz -C /opt/java --strip-components=1 \
    && rm /tmp/jdk.tar.gz
ENV JAVA_HOME=/opt/java
ENV PATH="$JAVA_HOME/bin:$PATH"

# Download and install Ghidra
ENV GHIDRA_VERSION=12.0.2
RUN wget -q https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/ghidra_${GHIDRA_VERSION}_PUBLIC_20260129.zip -O /tmp/ghidra.zip \
    && unzip -q /tmp/ghidra.zip -d /opt \
    && rm /tmp/ghidra.zip \
    && ln -s /opt/ghidra_${GHIDRA_VERSION}_PUBLIC /opt/ghidra

# Add Ghidra to PATH
ENV PATH="/opt/ghidra/support:$PATH"

# Create projects directory for Ghidra
RUN mkdir -p /opt/ghidra-projects && chown node:node /opt/ghidra-projects

# ============================================
# End Ghidra section
# ============================================

# Switch back to non-root user
USER node

# Working directory already set by base image
WORKDIR /workspace/group
