# Warmaster Agent Container
# Extends base nanoclaw-agent with offensive/admin tools for VM management and pentesting

FROM nanoclaw-agent:latest

# Switch to root to install packages
USER root

# Install offensive/admin tools
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-venv \
    openssh-client \
    sshpass \
    nmap \
    netcat-openbsd \
    dnsutils \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages for Windows remote management
RUN pip3 install --break-system-packages \
    pywinrm \
    requests \
    impacket \
    ldap3

# Switch back to non-root user
USER node

# Working directory already set by base image
WORKDIR /workspace/group
